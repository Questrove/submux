<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Submux Runtime</title>
  <organization>com.byworld.submux</organization>
  <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
  <options customize="never" require-scripts="true" hostArchitectures="x86_64,arm64"/>
  <allowed-os-versions>
    <os-version min="13.0"/>
  </allowed-os-versions>
  <choices-outline>
    <line choice="runtime"/>
  </choices-outline>
  <choice id="runtime" visible="false">
    <pkg-ref id="com.byworld.submux.runtime"/>
  </choice>
  <pkg-ref id="com.byworld.submux.runtime" version="@PRODUCT_VERSION@">submux-runtime-component.pkg</pkg-ref>
</installer-gui-script>
