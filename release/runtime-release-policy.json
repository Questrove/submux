      "max_bytes": 20971520
    },
    {
      "pattern": "submux-windows-*",
      "max_bytes": 20971520
    },
    {
      "pattern": "submux-darwin-*",
      "max_bytes": 20971520
    },
    {
      "pattern": "submux-runtime-linux-*",
      "max_bytes": 20971520,
