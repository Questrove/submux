      "approval": "Issue #25 preview exception: Runtime binaries are awaiting size optimization before stable support"
    },
    {
      "pattern": "submux-runtime-windows-*",
      "max_bytes": 20971520,
      "approved_max_bytes": 26214400,
      "approval": "Issue #25 preview exception: Runtime binaries are awaiting size optimization before stable support"
    },
    {
      "pattern": "submux-runtime-darwin-*",
      "max_bytes": 20971520,
