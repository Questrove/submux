{
  "schema": 1,
  "forbidden_tokens": [
    "submux-agent",
    "SubmuxAgent",
    "submux_agent",
    "bootstrap-agent",
    "runtime-enrollment",
    "-----BEGIN PRIVATE KEY-----",
    "-----BEGIN OPENSSH PRIVATE KEY-----"
  ],
  "secret_prefixes": [
    "ghp_",
    "gho_",
    "ghu_",
    "ghs_",
    "github_pat_",
    "AKIA"
  ],
  "budget_required_patterns": [
    "submux-*",
    "*.exe",
    "*.zip",
    "*.gz",
    "*.zst",
    "*.deb",
    "*.rpm",
    "*.msi",
    "*.pkg"
  ],
  "budgets": [
