{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Submux Runtime",
  "version": "0.0.0",
  "identifier": "cn.byworld.submux.runtime",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Submux Runtime",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' asset: data:; style-src 'self'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
